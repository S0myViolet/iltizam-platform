{
  "name": "iltizam-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 4040",
    "build": "next build --turbopack",
    "start": "next start -p 4040",
    "lint": "eslint",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate dev",
