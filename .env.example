# Postgres connection for the app (use your provider's POOLED string, e.g.
# Neon's "-pooler" host, when deploying to serverless).
DATABASE_URL="postgresql://user:password@host:5432/iltizam"
# Unpooled/direct connection for Prisma Migrate. Locally this can be the
# same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/iltizam"
# Provided automatically when a Vercel Blob store is connected; when unset,
# evidence uploads fall back to local-disk storage under ./uploads (dev).
# BLOB_READ_WRITE_TOKEN=

# Signs the demo session cookie (HMAC). Set a long random value in every
# deployed environment: `openssl rand -base64 48`.
SESSION_SECRET="change-me-to-a-long-random-value"

# Demonstration tools (Run Demonstration Scan, Reset Demonstration, demo
# operations dashboard). Always on in development; in production they stay
# hidden unless this is explicitly "true". Never enable on a client-facing
# deployment that holds real data.
ENABLE_DEMO_TOOLS="true"

# Public marketing site the app links back to (header, footer, sign-in page).
# Defaults to the shared Iltzam landing page when unset.
# NEXT_PUBLIC_MAIN_WEBSITE_URL="https://www.iltzam.example"

# Local demonstration credentials. The seed creates the platform administrator
# from these values (defaults shown); all other seeded demo users share
# DEMO_USER_PASSWORD.
# DEMO_ADMIN_EMAIL="platform.admin@iltzam.example"
# DEMO_ADMIN_PASSWORD="iltzam-demo"
# DEMO_USER_PASSWORD="iltzam-demo"
