# Postgres connection for the app (use your provider's POOLED string, e.g.
# Neon's "-pooler" host, when deploying to serverless).
DATABASE_URL="postgresql://user:password@host:5432/iltizam"
# Unpooled/direct connection for Prisma Migrate. Locally this can be the
# same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/iltizam"
# Provided automatically when a Vercel Blob store is connected; when unset,
# evidence uploads fall back to local-disk storage under ./uploads (dev).
# BLOB_READ_WRITE_TOKEN=
