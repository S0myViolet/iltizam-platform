// Iltzam compliance platform — data model
//
// Layering (see docs/Iltzam_GDPR_Control_Framework):
//   Regulation (versioned law)  ←  RegulationControlMapping  →  Control (law-agnostic library)
//   Assessment (one per company run)  →  ControlAnswer (one per applicable control)  →  Evidence
//
// Enum-like fields are strings validated by the typed constants in
// src/lib/types.ts, and list fields (regimes, evidence examples) are stored
// as JSON strings — a deliberate portability choice kept from the SQLite
// original so the schema works unchanged across databases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection string (e.g. Neon's -pooler host) for the app at
  // runtime; DIRECT_URL is the unpooled connection Prisma Migrate needs.
  // For local development both can be the same plain connection string.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Regulation layer — laws are versioned so controls are never hard-coded to
// one legal text. When a law changes, add a new Regulation row (or bump the
// version) and remap controls; client assessments keep pointing at controls.
// ---------------------------------------------------------------------------

model Regulation {
  id                 String    @id @default(cuid())
  code               String    @unique // "EU-GDPR", "EG-PDPL"
  name               String
  jurisdiction       String? // "European Union", "Egypt"
  version            String // "2016/679", "Law 151/2020 + Executive Regulations 816/2025"
  legalInstrument    String? // "Regulation (EU) 2016/679", "Law No. 151 of 2020 …"
  effectiveDate      DateTime?
  complianceDeadline DateTime? // e.g. PDPL: 1 November 2026
  regulator          String? // "Personal Data Protection Center (PDPC)"
  status             String // RegulationStatus: in_force | implementation_period | provisional | draft | superseded
  description        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  controlMappings RegulationControlMapping[]
}

// One control ↔ many regulations — the crosswalk. A control has exactly one
// SOURCE regulation (the law it was extracted from, on the Control row) and
// may additionally map to other regulations here with a mapping status.
model RegulationControlMapping {
  id           String  @id @default(cuid())
  regulationId String
  controlId    String
  // Citation into this regulation's text, e.g. "Art. 33(1)".
  articleReference String?
  // MappingStatus: exact | similar | partial | egypt_specific | gdpr_specific | provisional
  mappingStatus String  @default("exact")
  provisional   Boolean @default(false)
  notes         String?

  regulation Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  control    Control    @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@unique([regulationId, controlId])
  @@index([controlId])
}

// ---------------------------------------------------------------------------
// Control library — the master questionnaire. Seeded from the Iltzam Control
// Library document (64 controls across 14 domains).
// ---------------------------------------------------------------------------

model Control {
  id               String   @id @default(cuid())
  controlCode      String   @unique // "GOV-01" … "TRA-02", "EGP-GOV-01" …
  question         String // plain-language yes/no question (exact library wording)
  description      String // formal control statement from the framework document
  domain           String // domain name, e.g. "Governance & Accountability"
  domainOrder      Int // order of the domain as the platform presents it
  orderInDomain    Int // order of the control within its domain
  severity         String // Severity: legally_mandatory | important
  isMandatory      Boolean
  // The regulation this control was extracted from ("EU-GDPR", "EG-PDPL").
  // Assessments instantiate controls whose source is among the selected
  // regulations; crosswalk rows in RegulationControlMapping express overlap.
  sourceRegulationCode String @default("EU-GDPR")
  // Display citation, e.g. "GDPR Art. 33(1)" or "PDPL Art. 4(10), 26".
  legalBasis       String   @default("")
  // True where the source document marks the control itself as provisional
  // (e.g. PDPL Impact Assessment controls pending PDPC guidance).
  provisional      Boolean  @default(false)
  // JSON string[] of roles the control applies to, e.g. ["controller","processor"].
  appliesToRoles   String   @default("[\"controller\"]")
  evidenceExamples String // JSON string[] — artifacts that prove the control
  whyItMatters     String // plain-language rationale shown in gap report
  recommendedAction String // plain-language next step shown in gap report
  sourceReference  String // e.g. "GDPR Art. 33(1) · framework BRE-02"
  requiresEvidence Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  regulationMappings RegulationControlMapping[]
  answers            ControlAnswer[]

  @@index([domain])
  @@index([sourceRegulationCode])
}

// ---------------------------------------------------------------------------
// Assessment layer — each company gets its own instance of every applicable
// control, created when the assessment starts.
// ---------------------------------------------------------------------------

model Assessment {
  id              String    @id @default(cuid())
  companyName     String
  companySize     String? // CompanySize bucket
  industry        String?
  country         String?
  selectedRegimes String // JSON string[] of regulation codes, e.g. ["EG-PDPL","EU-GDPR"]
  status          String    @default("not_started") // AssessmentStatus
  readinessScore  Float? // cached last-computed scores (recomputed on read)
  mandatoryScore  Float?
  importantScore  Float?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  answers ControlAnswer[]
}

model ControlAnswer {
  id                String    @id @default(cuid())
  assessmentId      String
  controlId         String
  answer            String    @default("not_answered") // AnswerValue: yes | no | not_answered | not_applicable
  ownerName         String?
  ownerEmail        String?
  notes             String?
  dueDate           DateTime?
  remediationStatus String    @default("not_started") // RemediationStatus
  lastReviewedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  control    Control    @relation(fields: [controlId], references: [id], onDelete: Cascade)
  evidence   Evidence[]

  @@unique([assessmentId, controlId])
  @@index([assessmentId])
}

model Evidence {
  id           String   @id @default(cuid())
  answerId     String
  kind         String // EvidenceKind: file | link
  fileName     String // display name (file name or link title)
  fileUrl      String // public URL for links; storage path for uploaded files
  storageKey   String? // relative key under the upload root for uploaded files
  evidenceType String // EvidenceType: policy_document | signed_agreement | register | ...
  uploadedBy   String?
  uploadedAt   DateTime @default(now())

  answer ControlAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([answerId])
}
