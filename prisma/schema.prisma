// Iltzam compliance platform — data model v2 (multi-tenant).
//
// Layering:
//   Organization ← OrganizationMembership → User          (tenancy & roles)
//   Regulation ← RegulationControlMapping → Control ← ControlDomain
//   Assessment (org-scoped) ← AssessmentRegulation → Regulation
//   Assessment → ControlAnswer (one per applicable control) → Evidence / ControlComment
//   Organization → DataInventoryItem / Connector → SynchronizationRun → ConnectorResource
//   MonitoringRule → MonitoringFinding → FindingControlMapping
//   AuditLog records every material action with its origin (human / automated_rule / system_job / optional_ai)
//
// Enum-like fields are strings validated by typed constants in src/lib/types.ts
// (kept portable, not DB enums). List fields are JSON strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

model Organization {
  id                  String    @id @default(cuid())
  name                String
  legalName           String?
  country             String?
  industry            String?
  companySize         String?
  registrationNumber  String?
  primaryContactName  String?
  primaryContactEmail String?
  timezone            String?
  demoOrganization    Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  archivedAt          DateTime?

  memberships OrganizationMembership[]
  assessments Assessment[]
  evidence    Evidence[]
  inventory   DataInventoryItem[]
  connectors  Connector[]
  syncRuns    SynchronizationRun[]
  resources   ConnectorResource[]
  findings    MonitoringFinding[]
  reports     Report[]
  auditLogs   AuditLog[]
}

model User {
  id                       String   @id @default(cuid())
  authenticationProviderId String?  @unique
  name                     String
  email                    String   @unique
  // Demo-grade authentication: platform admin flag lives on the user.
  isPlatformAdmin          Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  role           String // MembershipRole: client_admin | compliance_manager | control_owner | reviewer | viewer
  status         String    @default("active") // invited | active | suspended | removed
  invitedAt      DateTime?
  joinedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ─── Regulation layer ───────────────────────────────────────────────────────

model Regulation {
  id                 String    @id @default(cuid())
  code               String    @unique // "EU-GDPR", "EG-PDPL"
  name               String
  jurisdiction       String?
  legalInstrument    String?
  version            String
  regulator          String?
  regulatorCode      String?
  effectiveDate      DateTime?
  complianceDeadline DateTime?
  status             String // draft | implementation_period | active | superseded | archived
  description        String?
  sourceDocument     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  controlMappings       RegulationControlMapping[]
  assessmentRegulations AssessmentRegulation[]
}

model ControlDomain {
  id           String   @id @default(cuid())
  code         String   @unique // "GOV", "EG-GOV", …
  name         String
  description  String?
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  controls Control[]
}

model Control {
  id                String   @id @default(cuid())
  controlCode       String   @unique // "GOV-01" … / "EG-GOV-01" …
  domainId          String
  question          String
  description       String
  whyItMatters      String
  severity          String // legally_mandatory | important
  isMandatory       Boolean
  requiresEvidence  Boolean  @default(true)
  evidenceExamples  String // JSON string[]
  recommendedAction String
  sourceReference   String
  provisional       Boolean  @default(false)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  domain             ControlDomain              @relation(fields: [domainId], references: [id])
  regulationMappings RegulationControlMapping[]
  answers            ControlAnswer[]
  findingMappings    FindingControlMapping[]

  @@index([domainId])
}

model RegulationControlMapping {
  id            String    @id @default(cuid())
  regulationId  String
  controlId     String
  legalBasis    String? // e.g. "Art 4.10, 26" (PDPL) or "Art. 33(1)" (GDPR)
  mappingType   String    @default("exact") // exact | similar | partial | regulation_specific | provisional
  mappingNotes  String?
  provisional   Boolean   @default(false)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  regulation Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  control    Control    @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@unique([regulationId, controlId])
  @@index([controlId])
}

// ─── Assessment layer ───────────────────────────────────────────────────────

model Assessment {
  id              String    @id @default(cuid())
  organizationId  String
  title           String
  status          String    @default("not_started") // not_started | in_progress | needs_review | completed | archived
  startedByUserId String?
  startedAt       DateTime?
  completedAt     DateTime?
  lastReviewedAt  DateTime?
  nextReviewAt    DateTime?
  readinessScore  Float?
  mandatoryScore  Float?
  importantScore  Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  regulations  AssessmentRegulation[]
  answers      ControlAnswer[]
  reports      Report[]

  @@index([organizationId])
}

model AssessmentRegulation {
  id           String   @id @default(cuid())
  assessmentId String
  regulationId String
  createdAt    DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  regulation Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, regulationId])
}

model ControlAnswer {
  id                String    @id @default(cuid())
  assessmentId      String
  controlId         String
  answer            String    @default("not_answered") // yes | no | not_answered | not_applicable
  ownerMembershipId String?
  ownerName         String?
  ownerEmail        String?
  notes             String?
  dueDate           DateTime?
  remediationStatus String    @default("not_started") // not_started | in_progress | evidence_required | ready_for_review | accepted | closed
  lastReviewedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assessment Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  control    Control          @relation(fields: [controlId], references: [id], onDelete: Cascade)
  evidence   Evidence[]
  comments   ControlComment[]

  @@unique([assessmentId, controlId])
  @@index([assessmentId])
}

model ControlComment {
  id                String   @id @default(cuid())
  assessmentControlId String
  userId            String?
  authorName        String?
  body              String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assessmentControl ControlAnswer @relation(fields: [assessmentControlId], references: [id], onDelete: Cascade)

  @@index([assessmentControlId])
}

model Evidence {
  id               String    @id @default(cuid())
  organizationId   String?
  answerId         String
  uploadedByUserId String?
  kind             String // file | link
  fileName         String
  originalFileName String?
  fileUrl          String
  storageKey       String?
  mimeType         String?
  sizeBytes        Int?
  checksum         String?
  evidenceType     String
  description      String?
  reviewStatus     String    @default("unreviewed") // unreviewed | accepted | rejected | expired | needs_update
  reviewNotes      String?
  validFrom        DateTime?
  expiresAt        DateTime?
  uploadedBy       String?
  uploadedAt       DateTime  @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  answer       ControlAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([answerId])
  @@index([organizationId])
}

model Report {
  id                String    @id @default(cuid())
  organizationId    String
  assessmentId      String?
  type              String // gap_report | audit_readiness | management_summary | evidence_register | control_export | backend_demo_export
  status            String    @default("completed") // queued | generating | completed | failed
  generatedByUserId String?
  storageKey        String?
  generatedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment   Assessment?  @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  actorName      String?
  origin         String   @default("human") // human | automated_rule | system_job | optional_ai
  action         String
  entityType     String?
  entityId       String?
  summary        String
  beforeData     String? // JSON
  afterData      String? // JSON
  metadata       String? // JSON
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ─── Inventory & monitoring layer ───────────────────────────────────────────

model DataInventoryItem {
  id                      String    @id @default(cuid())
  organizationId          String
  connectorId             String?
  externalResourceId      String?
  name                    String
  systemName              String?
  sourceType              String    @default("manual") // manual | connector
  businessOwner           String?
  technicalOwner          String?
  dataCategories          String // JSON string[]
  sensitiveDataCategories String // JSON string[]
  dataSubjects            String // JSON string[]
  processingPurposes      String // JSON string[]
  lawfulBasis             String?
  storageLocations        String // JSON string[]
  destinationCountries    String // JSON string[]
  retentionPeriod         String?
  retentionDate           DateTime?
  processors              String // JSON string[]
  containsPersonalData    Boolean   @default(false)
  containsSensitiveData   Boolean   @default(false)
  crossBorderTransfer     Boolean   @default(false)
  sharingStatus           String? // private | internal | broad | public
  encryptionStatus        String? // encrypted | unencrypted | unknown
  status                  String    @default("active") // active | archived
  lastReviewedAt          DateTime?
  lastScannedAt           DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector    Connector?   @relation(fields: [connectorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, connectorId, externalResourceId])
  @@index([organizationId])
}

model Connector {
  id                            String    @id @default(cuid())
  organizationId                String
  provider                      String // demo_connector | manual_upload | microsoft_365 | …
  displayName                   String
  status                        String    @default("draft") // draft | connecting | connected | syncing | error | paused | disconnected
  authenticationType            String? // none | oauth | api_key
  encryptedCredentialsReference String? // opaque reference; never the credential itself
  grantedScopes                 String // JSON string[]
  configuration                 String? // JSON
  lastSyncAt                    DateTime?
  nextSyncAt                    DateTime?
  lastSuccessfulSyncAt          DateTime?
  lastError                     String?
  createdByUserId               String?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncRuns     SynchronizationRun[]
  resources    ConnectorResource[]
  inventory    DataInventoryItem[]
  findings     MonitoringFinding[]

  @@index([organizationId])
}

model SynchronizationRun {
  id                        String    @id @default(cuid())
  organizationId            String
  connectorId               String
  status                    String    @default("queued") // queued | running | completed | completed_with_errors | failed
  stage                     String    @default("queued") // queued | connecting | discovering | normalizing | evaluating_rules | mapping_controls | updating_readiness | completed
  startedAt                 DateTime?
  completedAt               DateTime?
  resourcesDiscovered       Int       @default(0)
  resourcesCreated          Int       @default(0)
  resourcesUpdated          Int       @default(0)
  findingsCreated           Int       @default(0)
  evidenceCandidatesCreated Int       @default(0)
  errorsCount               Int       @default(0)
  triggeredByUserId         String?
  triggerType               String    @default("manual") // manual | scheduled | demonstration
  errorSummary              String?
  // Deterministic before/after snapshots of the official position (JSON).
  scoreBefore               String?
  scoreAfter                String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector    Connector           @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  resources    ConnectorResource[]
  findings     MonitoringFinding[]

  @@index([organizationId, createdAt])
}

model ConnectorResource {
  id                   String    @id @default(cuid())
  organizationId       String
  connectorId          String
  synchronizationRunId String?
  externalId           String
  resourceType         String // file | record
  name                 String
  location             String?
  owner                String?
  mimeType             String?
  sizeBytes            Int?
  sharingStatus        String?
  classification       String?
  metadata             String // JSON — normalized resource metadata the rules evaluate
  createdExternallyAt  DateTime?
  modifiedExternallyAt DateTime?
  lastSeenAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector    Connector           @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  syncRun      SynchronizationRun? @relation(fields: [synchronizationRunId], references: [id], onDelete: SetNull)
  findings     MonitoringFinding[]

  @@unique([connectorId, externalId])
  @@index([organizationId])
}

model MonitoringRule {
  id                     String    @id @default(cuid())
  code                   String // "DEMO-ACCESS-001"
  version                Int       @default(1)
  name                   String
  description            String
  category               String // access_control | sensitive_data | cross_border_transfer | …
  severity               String // high | medium | low | info
  enabled                Boolean   @default(true)
  conditionType          String    @default("structured")
  conditionConfiguration String // JSON — structured condition evaluated deterministically
  relatedControlCodes    String // JSON string[] of control codes
  regulationCodes        String // JSON string[]
  recommendedAction      String
  requiresHumanReview    Boolean   @default(true)
  effectiveFrom          DateTime?
  effectiveTo            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  findings MonitoringFinding[]

  @@unique([code, version])
}

model MonitoringFinding {
  id                        String    @id @default(cuid())
  organizationId            String
  connectorId               String?
  synchronizationRunId      String?
  connectorResourceId       String?
  monitoringRuleId          String
  ruleCode                  String
  ruleVersion               Int
  // Deterministic dedup key: ruleCode + resource external id (+ org).
  dedupKey                  String
  title                     String
  description               String
  severity                  String
  status                    String    @default("new") // new | under_review | confirmed | dismissed | resolved
  isEvidenceCandidate       Boolean   @default(false)
  suggestedEvidenceType     String?
  confidence                String? // deterministic rules report "rule_match"
  detectedAt                DateTime  @default(now())
  reviewedAt                DateTime?
  reviewedByUserId          String?
  reviewedByName            String?
  assignedOwnerMembershipId String?
  assignedOwnerName         String?
  resolutionNotes           String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector    Connector?          @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  syncRun      SynchronizationRun? @relation(fields: [synchronizationRunId], references: [id], onDelete: SetNull)
  resource    ConnectorResource?   @relation(fields: [connectorResourceId], references: [id], onDelete: SetNull)
  rule         MonitoringRule      @relation(fields: [monitoringRuleId], references: [id])
  controlMappings FindingControlMapping[]

  @@unique([organizationId, dedupKey])
  @@index([organizationId, status])
}

model FindingControlMapping {
  id                String   @id @default(cuid())
  findingId         String
  controlId         String
  mappingReason     String
  mappingSource     String   @default("deterministic_rule") // deterministic_rule | manual | ai_suggestion
  mappingConfidence String?
  reviewStatus      String   @default("pending") // pending | accepted | rejected
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  finding MonitoringFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  control Control           @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@unique([findingId, controlId])
}

// Optional AI assistance layer — stores suggestions only; never source of truth.
model AiSuggestion {
  id             String    @id @default(cuid())
  organizationId String?
  entityType     String
  entityId       String
  kind           String // summary | evidence_type | control_mapping | remediation_draft | management_summary | explanation
  suggestion     String
  confidence     String?
  promptVersion  String?
  modelId        String?
  reviewStatus   String    @default("pending_human_review") // pending_human_review | accepted | rejected
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
}
